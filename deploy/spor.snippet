# Caddyfile snippet for spor. Import it or paste into the main Caddyfile.
#
# lytt.txtv.no is the only origin (one service worker cache, one set of
# OpenGraph URLs). The other names redirect to it with a 308.
musikk.txtv.no, tracks.txtv.no {
	redir https://lytt.txtv.no{uri} permanent
}

lytt.txtv.no {
	# Compress text only. Media under /m/ is already compressed, so leave it
	# alone. spor pre-gzips library.json and static assets itself, and Caddy
	# does not re-encode responses that already carry Content-Encoding.
	@text path / /t/* /api/* /static/* /sw.js
	encode @text zstd gzip

	reverse_proxy 127.0.0.1:8740 {
		# spor trusts X-Forwarded-For only from loopback (trust_proxy = true)
		# and uses the right-most entry for per-IP rate limiting. Overwrite
		# the header so clients cannot inject their own entries.
		header_up X-Forwarded-For {remote_host}
		health_uri /healthz
		health_interval 30s
	}
}
